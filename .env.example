# Backend
DB_URL=jdbc:postgresql://localhost:5432/ruledb
DB_USERNAME=ruleuser
DB_PASSWORD=rulepass
SERVER_PORT=8080

# Optional Redis pub/sub for multi-node rule refresh
RULE_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend development origin(s), comma separated patterns
RULE_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173

# Logging
APP_LOG_LEVEL=INFO
ROOT_LOG_LEVEL=INFO
KIE_LOG_LEVEL=WARN
DROOLS_LOG_LEVEL=WARN
