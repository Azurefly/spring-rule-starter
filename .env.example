# Backend
DB_URL=jdbc:postgresql://localhost:5432/ruledb
DB_USERNAME=ruleuser
DB_PASSWORD=rulepass
SERVER_PORT=8080

# Database migration / ORM validation
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Optional Redis pub/sub for multi-node rule refresh
RULE_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
MANAGEMENT_REDIS_HEALTH_ENABLED=false

# Admin API security. Enable for controlled/shared environments.
# Keys must be at least 16 characters. Reader key is optional.
RULE_SECURITY_ENABLED=false
RULE_SECURITY_HEADER=X-Rule-Api-Key
RULE_ADMIN_API_KEY=
RULE_READER_API_KEY=

# Frontend development origin(s), comma separated patterns
RULE_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173
RULE_MAX_FILE_SIZE=1MB
RULE_MAX_REQUEST_SIZE=1MB

# Rule runtime metrics are emitted when a MeterRegistry is available.
RULE_METRICS_ENABLED=true

# Actuator (non-health endpoints require ADMIN when rule security is enabled)
MANAGEMENT_ENDPOINTS=health,info
MANAGEMENT_HEALTH_SHOW_DETAILS=never

# Logging
APP_LOG_LEVEL=INFO
STARTER_LOG_LEVEL=INFO
ROOT_LOG_LEVEL=INFO
KIE_LOG_LEVEL=WARN
DROOLS_LOG_LEVEL=WARN
